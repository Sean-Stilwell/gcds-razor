@page "/en/components"
@page "/fr/composants"
@inject NavigationManager Navigation

<PageTitle>@(IsFrench ? "Composants Blazor GCDS" : "GCDS Blazor components")</PageTitle>

<GcdsHeading Tag="h1">@(IsFrench ? "Composants Blazor GCDS" : "GCDS Blazor components")</GcdsHeading>
<GcdsText>
    @(IsFrench
        ? "Cette bibliothèque fournit des composants Blazor typés pour les éléments Web du Système de design GC. Chaque page porte sur l’API de l’adaptateur; consultez le site officiel pour les conseils de conception et d’accessibilité."
        : "This library provides typed Blazor components for GC Design System web components. Each page focuses on the wrapper API; consult the official site for design and accessibility guidance.")
</GcdsText>

<GcdsHeading Tag="h2">@(IsFrench ? "Installation" : "Installation")</GcdsHeading>
<GcdsText>
    @(IsFrench
        ? "Installez le paquet à partir de NuGet :"
        : "Install the package from NuGet:")
</GcdsText>
<CodeBlock Language="@Language" Code="@NuGetPackageSnippet" />
<GcdsText>
    @(IsFrench
        ? "Pour développer à partir de ce dépôt, référencez plutôt directement le projet de bibliothèque :"
        : "When developing against this repository, reference the library project directly instead:")
</GcdsText>
<CodeBlock Language="@Language" Code="@ProjectReferenceSnippet" />
<GcdsText>
    @(IsFrench
        ? "Ajoutez l'espace de noms au fichier _Imports.razor de votre application :"
        : "Add the namespace to your app's _Imports.razor:")
</GcdsText>
<CodeBlock Language="@Language" Code="@ImportsSnippet" />
<GcdsText>
    @(IsFrench
        ? "Rendez GcdsAssets une seule fois près de la racine de l'application, par exemple dans App.razor :"
        : "Render GcdsAssets once near the root of the app, such as in App.razor:")
</GcdsText>
<CodeBlock Language="@Language" Code="@AssetsSnippet" />
<GcdsText>
    @(IsFrench
        ? "GcdsAssets charge la feuille de style officielle et le module ES depuis le CDN du Système de design GC. Plusieurs instances n’ajoutent pas les ressources en double."
        : "GcdsAssets loads the official stylesheet and ES module from the GCDS CDN. Duplicate instances do not add duplicate assets.")
</GcdsText>

<GcdsHeading Tag="h2">@(IsFrench ? "Référence des composants" : "Component reference")</GcdsHeading>
@foreach (var category in Enum.GetValues<DocsCategory>())
{
    <GcdsHeading Tag="h3">@DocsCatalog.CategoryName(category).Get(Language)</GcdsHeading>
    <GcdsGrid Columns="1fr" ColumnsTablet="1fr 1fr" ColumnsDesktop="1fr 1fr 1fr" Gap="300" EqualRowHeight>
        @foreach (var item in DocsCatalog.All.Where(item => item.Category == category))
        {
            <GcdsCard CardTitle="@item.TitleFor(Language)" Href="@SiteHref(item.RouteFor(Language))" Description="@item.SummaryFor(Language)" />
        }
    </GcdsGrid>
}

@code {
    private DocsLanguage Language => DocsLanguageExtensions.FromPath(Navigation.ToBaseRelativePath(Navigation.Uri));
    private bool IsFrench => Language == DocsLanguage.French;
    private string SiteHref(string route) => Navigation.ToAbsoluteUri(route.TrimStart('/')).ToString();
    private const string NuGetPackageSnippet = "dotnet add YourApp/YourApp.csproj package GcdsWrapper.Blazor";
    private const string ProjectReferenceSnippet = "dotnet add YourApp/YourApp.csproj reference GcdsWrapper.Blazor/GcdsWrapper.Blazor.csproj";
    private const string ImportsSnippet = "@using GcdsWrapper.Blazor";
    private const string AssetsSnippet = "<GcdsAssets />";
}
