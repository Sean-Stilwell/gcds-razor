@inherits GcdsFormInputBase<string[]?>

<gcds-checkboxes @ref="Element" name="@Name" legend="@Legend" options="@GcdsJson.Serialize(Options)"
                 value="@GcdsJson.Serialize(CurrentValue)" hint="@Hint"
                 error-message="@EffectiveErrorMessage" required="@Required" disabled="@Disabled"
                 autofocus="@Autofocus" hide-label="@HideLabel" hide-legend="@HideLegend"
                 form="@Form" validate-on="@ValidateOn.ToAttribute()"
                 @attributes="AdditionalAttributes"></gcds-checkboxes>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter, EditorRequired] public string Legend { get; set; } = default!;
    [Parameter, EditorRequired] public object Options { get; set; } = default!;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Form { get; set; }
    [Parameter] public bool Autofocus { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HideLabel { get; set; }
    [Parameter] public bool HideLegend { get; set; }
    [Parameter] public GcdsValidateOn ValidateOn { get; set; } = GcdsValidateOn.Blur;
}
