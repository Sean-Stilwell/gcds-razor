<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.1</Version>
    <PackageId>GcdsWrapper.Blazor</PackageId>
    <Title>GCDS Wrapper for Blazor</Title>
    <Authors>Sean Stilwell</Authors>
    <Description>Thin Blazor wrappers for the official GC Design System web components.</Description>
    <Copyright>Copyright (c) Sean Stilwell 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://seanstilwell.ca/gcds-razor/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sean-Stilwell/gcds-razor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;razor;gcds;canada;design-system;web-components</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

</Project>
