@inherits GcdsFormInputBase<string?>

<gcds-input @ref="Element" input-id="@Id" name="@Name" label="@Label" value="@CurrentValue"
            type="@Type.ToAttribute()" inputmode="@InputMode?.ToAttribute()" hint="@Hint"
            error-message="@EffectiveErrorMessage" required="@Required" disabled="@Disabled"
            readonly="@ReadOnly" hide-label="@HideLabel" autocomplete="@Autocomplete"
            minlength="@MinLength" maxlength="@MaxLength" min="@Min" max="@Max" step="@Step"
            pattern="@Pattern" size="@Size" suggestions="@GcdsJson.Serialize(Suggestions)"
            validate-on="@ValidateOn.ToAttribute()" form="@Form"
            @attributes="AdditionalAttributes"></gcds-input>

@code {
    protected override string[] EventNames =>
        [.. base.EventNames, "gcdsSuggestionSelected"];

    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter] public GcdsInputType Type { get; set; } = GcdsInputType.Text;
    [Parameter] public GcdsInputMode? InputMode { get; set; }
    [Parameter] public GcdsValidateOn ValidateOn { get; set; } = GcdsValidateOn.Blur;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public string? Form { get; set; }
    [Parameter] public string? Pattern { get; set; }
    [Parameter] public object? Suggestions { get; set; }
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public decimal? Step { get; set; }
    [Parameter] public int? MinLength { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public int? Size { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool HideLabel { get; set; }
}
