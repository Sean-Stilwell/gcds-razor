@inherits GcdsFormInputBase<string?>

<gcds-textarea @ref="Element" textarea-id="@Id" name="@Name" label="@Label"
               value="@CurrentValue" hint="@Hint" error-message="@EffectiveErrorMessage"
               required="@Required" disabled="@Disabled" autofocus="@Autofocus"
               hide-label="@HideLabel" hide-limit="@HideLimit" form="@Form"
               minlength="@MinLength" maxlength="@MaxLength" rows="@Rows" cols="@Cols"
               validate-on="@ValidateOn.ToAttribute()"
               @attributes="AdditionalAttributes"></gcds-textarea>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Form { get; set; }
    [Parameter] public int? MinLength { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public int? Rows { get; set; }
    [Parameter] public int? Cols { get; set; }
    [Parameter] public bool Autofocus { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HideLabel { get; set; }
    [Parameter] public bool HideLimit { get; set; }
    [Parameter] public GcdsValidateOn ValidateOn { get; set; } = GcdsValidateOn.Blur;
}
